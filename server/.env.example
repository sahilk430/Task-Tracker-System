# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/seo-task-tracker?retryWrites=true&w=majority

# Secret used to sign login tokens — use a long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

PORT=5001
# Comma-separated list of allowed frontend origins (only needed for a separately hosted frontend)
CLIENT_URL=http://localhost:5173

# ── Optional ─────────────────────────────────────────────────────────
# Public address of the app, used in email links (Render sets RENDER_EXTERNAL_URL automatically)
# APP_URL=https://seo-task-tracker.onrender.com

# Email (task assignments, mentions, reminders, password reset). Without SMTP_HOST no email
# is sent; in-app notifications and admin reset links still work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# MAIL_FROM="SEO Task Tracker <you@example.com>"

# Reminders: time zone for the daily digest, hour it goes out, check interval
# APP_TIMEZONE=Asia/Kolkata
# DIGEST_HOUR=9
# REMINDER_INTERVAL_MINUTES=15
# REMINDERS_ENABLED=true
