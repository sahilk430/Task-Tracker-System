# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/seo-task-tracker?retryWrites=true&w=majority

# Secret used to sign login tokens — use a long random string
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

PORT=5001
# Comma-separated list of allowed frontend origins (local + Vercel)
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
